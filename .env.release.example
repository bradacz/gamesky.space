# ==============================================================================
# GameSky.space — Release, Signing, Notarization & Bunny.net CDN Configuration
# Copy this file to '.env.release' (never commit '.env.release' to Git)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLE DEVELOPER CODE SIGNING & NOTARIZATION
# ------------------------------------------------------------------------------
# Name of your Developer ID certificate in macOS Keychain (verify with: security find-identity -v -p codesigning)
APPLE_SIGNING_IDENTITY="Developer ID Application: Marian Tomay (XXXXXXXXXX)"

# NOTARIZATION OPTION A: App Store Connect API Key (Recommended)
APPLE_API_KEY="AuthKey_XXXXXXXXXX"
APPLE_API_ISSUER="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
APPLE_API_KEY_PATH="./AuthKey_XXXXXXXXXX.p8"

# NOTARIZATION OPTION B: Apple ID & App-Specific Password (Alternative)
APPLE_ID="your-apple-id@domain.com"
APPLE_PASSWORD="abcd-efgh-ijkl-mnop"
APPLE_TEAM_ID="XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 2. TAURI V2 UPDATER MINISIGN KEYS
# Generate these automatically with: npm run release:keys
# ------------------------------------------------------------------------------
TAURI_SIGNING_PRIVATE_KEY="./.tauri-keys/updater.key"
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
GAMESKY_UPDATER_PUBKEY="dW50cnVzdGVkIGNvbW1lbnQ6..."

# ------------------------------------------------------------------------------
# 3. BUNNY.NET STORAGE CDN SETTINGS (Multi-project support with dedicated subfolder)
# ------------------------------------------------------------------------------
# Name of your Storage Zone in Bunny.net dashboard
BUNNY_STORAGE_ZONE_NAME="your-storage-zone"

# Dedicated subfolder for GameSky.space inside your shared Storage Zone
BUNNY_STORAGE_PATH="gamesky.space"

# Storage Zone Region endpoint:
# 'de' (Frankfurt/Default), 'ny' (New York), 'la' (Los Angeles), 'sg' (Singapore), 'syd' (Sydney), 'uk' (London), 'se' (Stockholm)
BUNNY_STORAGE_REGION="de"

# Storage Zone Access Key (Password) from Bunny.net Storage Zone Settings -> FTP & API Access
BUNNY_STORAGE_ACCESS_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Public CDN URL for downloads & auto-updates (e.g. https://cdn.gamesky.space or https://your-pullzone.b-cdn.net/gamesky.space)
BUNNY_CDN_BASE_URL="https://cdn.gamesky.space"

# Optional: Account API Key (from Bunny.net Account Settings) to automatically purge cache of latest.json
BUNNY_API_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
